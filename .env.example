# ─── Finnhub ─────────────────────────────────────────────────────────────────
# Get a free key at https://finnhub.io/register
FINNHUB_API_KEY=your_finnhub_api_key_here

# ─── NewsAPI ─────────────────────────────────────────────────────────────────
# Get a free key at https://newsapi.org/register
NEWSAPI_API_KEY=your_newsapi_api_key_here

# ─── SeaRates Logistics Explorer ─────────────────────────────────────────────
# Register at https://www.searates.com/reference/logistics-explorer/
SEARATES_API_KEY=your_searates_api_key_here
SEARATES_BASE_URL=https://api.searates.com

# ─── Weather (Open-Meteo – no key required) ──────────────────────────────────
# Default location for the weather widget
WEATHER_CITY=New York
WEATHER_LAT=40.7128
WEATHER_LON=-74.0060

# ─── Stock watchlist ─────────────────────────────────────────────────────────
# Comma-separated list of ticker symbols
WATCHLIST=AAPL,MSFT,GOOGL,AMZN,TSLA,NVDA
